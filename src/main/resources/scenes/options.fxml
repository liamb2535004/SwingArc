<?import javafx.scene.text.Text?>


<BorderPane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="720.0" prefWidth="1280.0" styleClass="generic-background" stylesheets="@styles.css" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="swingarc.controllers.OptionsController">
   <center>
      <GridPane alignment="CENTER" maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="720.0" prefWidth="1280.0">
        <columnConstraints>
          <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
          <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
        </columnConstraints>
        <rowConstraints>
          <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
          <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
          <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
        </rowConstraints>
         <children>
            <Label alignment="CENTER" prefWidth="250.0" style="-fx-font-size: 18;" text="Volume" />
            <Label alignment="CENTER" layoutX="10.0" layoutY="68.0" prefWidth="250.0" style="-fx-font-size: 18;" text="Power multiplier" GridPane.rowIndex="1" />
            <Label alignment="CENTER" layoutX="10.0" layoutY="68.0" prefWidth="250.0" style="-fx-font-size: 18;" text="Gravity multiplier" GridPane.rowIndex="2" />
            <HBox alignment="CENTER" spacing="20.0" GridPane.columnIndex="1">
               <children>
                  <Slider fx:id="volumeSlider" majorTickUnit="1.0" minorTickCount="0" prefWidth="400.0" snapToTicks="true" value="100.0" />
                  <Text fx:id="volumeText" strokeType="OUTSIDE" strokeWidth="0.0" style="-fx-fill: white; -fx-font-weight: bold; -fx-font-size: 20;" text="Text" textAlignment="CENTER" />
               </children>
            </HBox>
            <HBox alignment="CENTER" prefHeight="100.0" prefWidth="200.0" spacing="20.0" GridPane.columnIndex="1" GridPane.rowIndex="1">
               <children>
                  <Slider fx:id="powerSlider" majorTickUnit="1.0" max="3.5" min="0.5" minorTickCount="1" prefWidth="400.0" showTickMarks="true" snapToTicks="true" value="1.0" />
                  <Text fx:id="powerText" strokeType="OUTSIDE" strokeWidth="0.0" style="-fx-fill: white; -fx-font-weight: bold; -fx-font-size: 20;" text="Text" textAlignment="CENTER" />
               </children>
               <GridPane.margin>
                  <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
               </GridPane.margin>
            </HBox>
            <HBox alignment="CENTER" prefHeight="100.0" prefWidth="200.0" spacing="20.0" GridPane.columnIndex="1" GridPane.rowIndex="2">
               <children>
                  <Slider fx:id="gravitySlider" majorTickUnit="1.0" max="5.0" minorTickCount="1" prefWidth="400.0" showTickMarks="true" snapToTicks="true" value="1.0" />
                  <Text fx:id="gravityText" strokeType="OUTSIDE" strokeWidth="0.0" style="-fx-fill: white; -fx-font-weight: bold; -fx-font-size: 20;" text="Text" textAlignment="CENTER" />
               </children>
            </HBox>
         </children>
         <padding>
            <Insets bottom="30.0" left="30.0" right="30.0" top="30.0" />
         </padding>
      </GridPane>
   </center>
   <top>
      <Label prefHeight="42.0" prefWidth="1280.0" style="-fx-font-size: 20;" text="Options" BorderPane.alignment="CENTER" />
